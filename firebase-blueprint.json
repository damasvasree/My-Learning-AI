{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information and education level.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "educationLevel": { "type": "string", "enum": ["school", "college", "professional"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "educationLevel"]
    },
    "StudyMaterial": {
      "title": "Study Material",
      "description": "Uploaded study materials and extracted concepts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["pdf", "ppt", "text", "youtube"] },
        "content": { "type": "string" },
        "extractedTopics": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "type"]
    },
    "QuizResult": {
      "title": "Quiz Result",
      "description": "Results of quizzes taken by students.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "materialId": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "answers": { "type": "array", "items": { "type": "object" } },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "score", "totalQuestions"]
    },
    "TopicAnalysis": {
      "title": "Topic Analysis",
      "description": "Analysis of student performance per topic.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "topic": { "type": "string" },
        "masteryLevel": { "type": "string", "enum": ["strong", "medium", "weak"] },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "topic", "masteryLevel"]
    },
    "StudyPlan": {
      "title": "Study Plan",
      "description": "Adaptive study plans generated by AI.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "planDate": { "type": "string", "format": "date" },
        "tasks": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "planDate", "tasks"]
    },
    "UserActivity": {
      "title": "User Activity",
      "description": "Tracking daily learning behavior.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "activityType": { "type": "string" },
        "quizScore": { "type": "number" }
      },
      "required": ["userId", "date", "activityType"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/study_materials/{materialId}": { "schema": "StudyMaterial", "description": "Study materials" },
    "/quiz_results/{resultId}": { "schema": "QuizResult", "description": "Quiz performance" },
    "/topic_analysis/{analysisId}": { "schema": "TopicAnalysis", "description": "Topic mastery tracking" },
    "/study_plans/{planId}": { "schema": "StudyPlan", "description": "Daily study plans" },
    "/user_activity/{activityId}": { "schema": "UserActivity", "description": "Activity logs" }
  }
}
